@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <span class="me-2">Olá, @context.User.Identity?.Name!</span>
        
        <!-- Formulário POST para o endpoint registrado no Program.cs -->
        <form action="authentication/logout" method="post" class="d-inline">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-outline-danger btn-sm">
                Sair
            </button>
        </form>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login" class="btn btn-primary btn-sm">Entrar</a>
    </NotAuthorized>
</AuthorizeView>